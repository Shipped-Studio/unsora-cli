{
  "name": "unsora-cli",
  "version": "0.1.0",
  "description": "Official CLI for Unsora — AI video, image, music, and clipping from the terminal",
  "type": "module",
  "bin": {
    "unsora": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "unsora",
    "ai",
    "video",
    "image",
    "cli",
    "wavespeed"
  ],
  "author": "Shipped Studio",
