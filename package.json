  "repository": {
    "type": "git",
    "url": "https://github.com/Shipped-Studio/unsora-cli.git"
  },
  "homepage": "https://docs.tryunsora.com",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
